	(text "DB blocking capacitor  C59>1/2pi*868MHz*5 Ohm = C59>36.7pF, C59=47pF​‌\nRS= 50 Ohm, RL= 50 Ohm, F0= 868 MHz, fc=1.3 GHz​‌\ng1=1, g2=2, g3=1​‌\nc60=c61=1/2pi*fc*r0​‌\nL5=2R0/2pi*fc​‌\ncon fc=1.3GHz, C9=C10=2.4 e L5=12nH"
		(exclude_from_sim no)
		(at 337.566 89.662 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d29d6c35-1e79-45aa-9d63-b17e8658d3aa")
	)
	(text "This capacitor has to be C0G"
